// use prisma-next

model User {
  id                       Int      @id @default(autoincrement())
  name                     String
  email                    String   @unique
  passwordHash             String
  isEmailVerified          Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  profileData              Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  @@map("user")
}

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  @@map("workspace")
}

model WorkspaceMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@unique([workspaceId, userId])
  @@map("workspaceMember")
}

model Project {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  @@map("project")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  
  @@unique([projectId, userId])
  @@map("projectMember")
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      String    @default("Todo")
  priority    String    @default("Medium")
  labels      Json?     // Storing array of strings like ["backend", "setup"]
  dueDate     DateTime?
  assigneeId  Int?      // Optional: A task doesn't have to be assigned right away
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  @@map("task")
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  @@map("comment")
}
