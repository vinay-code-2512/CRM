// use prisma-next

model User {
  id                       Int      @id @default(autoincrement())
  name                     String
  email                    String   @unique
  passwordHash             String
  isEmailVerified          Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  profileData              Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  @@map("user")
}

model Workspace {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  @@map("workspace")
}

model WorkspaceMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  userId      Int
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@unique([workspaceId, userId])
  @@map("workspaceMember")
}

model Project {
  id          Int      @id @default(autoincrement())
  workspaceId Int
  name        String
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  @@map("project")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime
  
  @@unique([projectId, userId])
  @@map("projectMember")
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  description String?
  status      String    @default("Todo")
  priority    String    @default("Medium")
  labels      Json?     // Storing array of strings like ["backend", "setup"]
  dueDate     DateTime?
  assigneeId  Int?      // Optional: A task doesn't have to be assigned right away
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  @@map("task")
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  @@map("comment")
}


// The ActivityLog model tracks who did what and when. 
// It's an append-only audit trail.
model ActivityLog {
  id           Int      @id @default(autoincrement()) 
  
  workspaceId  Int?     
  projectId    Int?     
  actorId      Int      
  
  // What they did (e.g., "TASK_CREATED", "STATUS_CHANGED")
  action       String   
  
  // What they did it to (e.g., "Task", "Project", "Comment")
  targetEntity String   
  
  // The ID of the thing they modified (e.g., Task ID 5)
  targetId     Int      
  
  // Optional extra data (e.g., { "oldStatus": "Todo", "newStatus": "Done" })
  metadata     Json?    
  
  createdAt    DateTime @default(now())

  // Maps this model to a lowercase table name in PostgreSQL
  @@map("activityLog")
}
  
